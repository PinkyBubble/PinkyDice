      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFC4E0"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "21dc80e3-ceda-4763-b8d4-4fca1bf957d3"
      }
    },
    "owner": "pinkybubble"
  }
